# The site renders without any secrets. Keep preview mode until client sign-off.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_READY=false
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Set these THREE values for real contact-form delivery.
# CONTACT_FROM must be on a sender domain you verified in Resend.
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=

# Optional durable rate limiting for the contact endpoint (Upstash REST).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: disable the best-effort Drive poster import on build.
THRUX_SKIP_MEDIA_SYNC=false
# Optional: refuse a launch build if any required poster is missing.
THRUX_STRICT_MEDIA=false
# Comma-separated extra valid origins for a reverse proxy; no trailing slash.
CONTACT_ALLOWED_ORIGINS=
