{
  "name": "thrux",
  "version": "2.0.0",
  "private": true,
  "description": "THRUX Media Studios — immersive WebGL branding and creative studio experience.",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/sync-media.mjs --offline",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "media:sync": "node scripts/sync-media.mjs --refresh",
    "media:check": "node scripts/check-content.mjs",
    "check": "npm run test && npm run typecheck && npm run media:check",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@types/three": "^0.186.0",
    "gsap": "^3.15.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "~5.8.3"
  }
}
